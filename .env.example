# Example configuration. Copy this file to .env and fill in real values locally.
# .env is ignored by Git. Never put real secrets in this example file.
# These names are planned and may change as the code is written.

ENERGYOPS_ENVIRONMENT=local
ENERGYOPS_DATA_MODE=demo

# Application database connection (restricted role, no ownership of tables).
ENERGYOPS_DATABASE_URL=postgresql+psycopg://energyops_app:CHANGE_ME@localhost:5432/energyops_local

# Used only to run migrations (owner role). Never used by the running application.
ENERGYOPS_ADMIN_DATABASE_URL=postgresql+psycopg://energyops_owner:CHANGE_ME@localhost:5432/energyops_local

# Local development sign-in only. Generate a long random value yourself.
ENERGYOPS_LOCAL_JWT_SECRET=CHANGE_ME_LONG_RANDOM_VALUE

# Knowledge search embeddings: any OpenAI compatible embeddings endpoint. Leave all three empty
# to use the word-matching stand-in (not allowed in prod). The model must return 768 numbers.
ENERGYOPS_EMBEDDINGS_BASE_URL=
ENERGYOPS_EMBEDDINGS_API_KEY=
ENERGYOPS_EMBEDDINGS_MODEL=

# Model provider keys. Leave empty for providers you do not have API access to.
# A ChatGPT or Claude subscription is separate from API access and does not provide these.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
ANTHROPIC_API_KEY=
NEBIUS_API_KEY=
GEMINI_API_KEY=